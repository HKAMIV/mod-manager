{
  "identifier": "default",
  "description": "Default capabilities for the mod manager",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "updater:default",
    "process:allow-restart"
  ]
}
