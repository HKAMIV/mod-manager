{
  "productName": "Mod Manager",
  "version": "0.14.1",
  "identifier": "com.modmanager.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Mod Manager",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5RkVBOEEzMzcwMzRDRjkKUldUNVRBTTNvNmorK1VrOTZ5UDRhSHllOGluZDlFc2E2YW5OVy9mYVJqclRzZUt3Q29RVWJicGwK",
      "endpoints": [
        "https://github.com/HKAMIV/mod-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
